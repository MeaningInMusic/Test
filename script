  [ -n "$DOWNLOAD_URL" ] || { fail "Could not resolve xmrig download URL"; exit 1; }
  TMPFILE="$(mktemp /tmp/xmrig-XXXXXX.tar.gz)"
  if command -v curl &>/dev/null; then
    curl -L "$DOWNLOAD_URL" -o "$TMPFILE" && tar xzf "$TMPFILE" -C "$SCRIPT_DIR" --strip-components=1 2>/dev/null \
      || tar xzf "$TMPFILE" -C "$SCRIPT_DIR" 2>/dev/null
  elif command -v wget &>/dev/null; then
    wget -q "$DOWNLOAD_URL" -O "$TMPFILE" && tar xzf "$TMPFILE" -C "$SCRIPT_DIR" --strip-components=1 2>/dev/null \
      || tar xzf "$TMPFILE" -C "$SCRIPT_DIR" 2>/dev/null
  else
    fail "Neither curl nor wget found — cannot download binary"
    rm -f "$TMPFILE"; exit 1
  fi
  rm -f "$TMPFILE"
  [ -f "$XMRIG" ] && ok "Downloaded xmrig binary" || { fail "Download failed"; exit 1; }
else
  ok "xmrig binary found"

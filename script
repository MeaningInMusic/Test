# ── Launch ────────────────────────────────────────────────────────────────────
hdr "Starting XMRig"
echo -e "${GREEN}${BOLD}All checks passed — launching miner...${NC}\n"
exec "$XMRIG" --config "$CONFIG"
START_SH_EOF

# ── Performance tuning: optimal RandomX threads for THIS machine ──────────────
# RandomX is memory-bandwidth bound → one thread per physical core. On Apple
# Silicon that includes P- and E-cores; on Intel it avoids SMT/hyperthreading.
# Scales automatically from 8 GB laptops up to 128 GB / 20+ core Macs.
N_THREADS=""
case "$(uname -s)" in
  Darwin) N_THREADS="$(sysctl -n hw.physicalcpu 2>/dev/null)" ;;
  *)      N_THREADS="$(getconf _NPROCESSORS_ONLN 2>/dev/null)" ;;
esac
[ -n "${XMRIG_THREADS:-}" ] && N_THREADS="$XMRIG_THREADS"
{ [ "${N_THREADS:-0}" -ge 1 ] 2>/dev/null; } || N_THREADS=1
N_LIMIT="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo "$N_THREADS")"
[ "$N_THREADS" -gt "$N_LIMIT" ] && N_THREADS="$N_LIMIT"
RXLIST="0"; i=1; while [ "$i" -lt "$N_THREADS" ]; do RXLIST="$RXLIST, $i"; i=$((i+1)); done
GRLIST="[$N_THREADS, 0]"; i=1; while [ "$i" -lt "$N_THREADS" ]; do GRLIST="$GRLIST, [$N_THREADS, $i]"; i=$((i+1)); done
echo "Performance tuning: RandomX threads = $N_THREADS ($RXLIST)"

